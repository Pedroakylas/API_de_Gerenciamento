          "name": "01 - Criar Pedido Válido - Pedro Akylas (201) [Print 01]",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"[Pedro] Status code é 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"[Pedro] Pedido cadastrado com cliente 'Pedro Akylas'\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.cliente).to.eql(\"Pedro Akylas\");",
                  "    pm.expect(json.tipo).to.eql(\"entrega\");",
                  "    pm.expect(json.valor).to.eql(350);",
                  "    pm.expect(json.prioridade).to.eql(\"normal\");",
                  "    pm.expect(json.status).to.eql(\"recebido\");",
                  "    pm.expect(json.id).to.be.a(\"number\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Pedro Akylas\",\n  \"tipo\": \"entrega\",\n  \"valor\": 350,\n  \"prioridade\": \"normal\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pedidos",
              "host": ["{{baseUrl}}"],
              "path": ["pedidos"]
            },
            "description": "Cadastra pedido para o aluno Pedro Akylas. Retorna 201 Created com status inicial 'recebido'."
          }
